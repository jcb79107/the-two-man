{
  "name": "two-man-season-two-preview",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 3027",
    "build": "next build",
    "start": "node scripts/serve-preview.mjs",
    "lint": "eslint src app tests --ext .ts,.tsx",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "format:check": "prettier --check src app tests *.json *.ts *.mjs",
    "test:browser": "playwright test",
    "results": "node --import tsx scripts/publish-results.ts",
    "build:live": "NEXT_PUBLIC_SITE_MODE=offseason next build",
    "test:offseason": "playwright test --config playwright.offseason.config.ts",
    "test:simulation": "node --import tsx scripts/simulate-player-season.ts"
  },
  "dependencies": {
    "@fontsource/anton": "5.3.0",
    "next": "15.5.29",
    "react": "19.2.7",
    "react-dom": "19.2.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@playwright/test": "1.65.0",
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "8.72.1",
    "@typescript-eslint/parser": "8.72.1",
    "eslint": "^9.39.5",
    "eslint-config-next": "15.5.29",
    "prettier": "3.6.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^5.0.4"
  },
  "overrides": {
    "postcss": "8.5.30"
  }
}
