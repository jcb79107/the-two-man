# Local database connection used by Prisma and the app.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/the_two_man"

# Optional pooled/unpooled aliases supported by the runtime DB loader.
POSTGRES_PRISMA_URL=""
POSTGRES_URL=""
POSTGRES_URL_NON_POOLING=""
DATABASE_URL_UNPOOLED=""

# Required for commissioner/admin login.
ADMIN_PASSWORD="change-me"
ADMIN_SESSION_SECRET="replace-with-a-long-random-secret"

# Canonical app URL used for scorecard links, invites, admin links, and metadata.
NEXT_PUBLIC_APP_URL="http://localhost:3000"
APP_URL="http://localhost:3000"

# Optional Sentry settings. SENTRY_AUTH_TOKEN is only needed for release uploads during builds.
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_DSN=""
SENTRY_AUTH_TOKEN=""

# Production database guardrail. Vercel sets VERCEL_ENV automatically.
THE_TWO_MAN_VALIDATE_PROD_DB=""
THE_TWO_MAN_ENV="development"
APP_ENV="development"

# Optional preview-only demo fallback.
FAIRWAY_ENABLE_PREVIEW_DEMO=""

# Optional live course lookup and import settings.
GOLF_COURSE_API_KEY=""
DISABLED_UNLICENSED_SOURCES="false"
USGA_LOOKUP_SCRIPT=""

# Optional observability script settings.
SENTRY_ORG="jason-baer"
SENTRY_PROJECT="javascript-nextjs"
SENTRY_ENVIRONMENT="production"
OBSERVABILITY_ENV_FILE="/private/tmp/the-two-man-observability.env"
CLARITY_DAYS="3"
