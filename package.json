{
  "name": "the-two-man",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@11.6.2",
  "scripts": {
    "dev": "NEXT_PUBLIC_SITE_MODE=offseason npm run dev --prefix preview",
    "build": "npm run build:live --prefix preview",
    "start": "npm run start --prefix preview",
    "lint": "npm run lint --prefix preview",
    "test": "npm test --prefix preview",
    "typecheck": "npm run typecheck --prefix preview",
    "format:check": "npm run format:check --prefix preview",
    "test:browser": "npm run test:offseason --prefix preview",
    "security:artifacts": "node scripts/check_tracked_artifacts.mjs",
    "deploy:prod": "node scripts/require_github_synced_before_deploy.mjs && npm run build && cd preview && node scripts/package-preview.mjs --live && npx --yes vercel deploy --prebuilt --prod --yes --scope jcb79107s-projects"
  }
}
